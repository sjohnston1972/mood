{
  "name": "mood-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply mood --local",
    "migrate:remote": "wrangler d1 migrations apply mood --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.16",
    "@cloudflare/workers-types": "^4.20240725.0",
    "typescript": "^5.4.0",
    "vitest": "~2.1.0",
    "wrangler": "^3.78.0"
  }
}
